# The public origin, used to make share-preview URLs absolute. Optional on
# Vercel, which names the production deployment itself; set it for a custom domain.
NEXT_PUBLIC_SITE_URL=
# The one password that opens the trainer. Server-side only; changing it signs
# out every device. Without it every private page stays locked.
APP_PASSWORD=
# Server-side only — never prefix this NEXT_PUBLIC_, or the key ships to the browser.
GEMINI_API_KEY=
# Optional; defaults to gemini-3.6-flash.
GEMINI_MODEL=
